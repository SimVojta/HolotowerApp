<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Settings and reading positions are backed up;
     WebView data (cookies, including Cloudflare clearance) is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
